#pragma once

namespace tl
{
    /**
     * @brief A release of tensorlib, as major, minor and patch numbers.
     *
     * Before 1.0, a new minor release may break the API.
     */
    struct version
    {
        int major; ///< Major number.
        int minor; ///< Minor number.
        int patch; ///< Patch number.

        /// True when the three numbers are equal.
        friend constexpr bool operator==(const version&, const version&) = default;
    };

    /// The version these headers belong to.
    inline constexpr version header_version{.major = @PROJECT_VERSION_MAJOR@,
                                            .minor = @PROJECT_VERSION_MINOR@,
                                            .patch = @PROJECT_VERSION_PATCH@};

    /**
     * @brief The version of the compiled library the program is linked against.
     *
     * It differs from tl::header_version when the headers and the library come from
     * different installations, which is worth checking at start-up:
     *
     * @code
     * if (tl::library_version() != tl::header_version) { ... }
     * @endcode
     *
     * @return The version the library was built as.
     */
    version library_version() noexcept;
}
